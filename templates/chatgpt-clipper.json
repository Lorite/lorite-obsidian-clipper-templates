{
	"schemaVersion": "0.1.0",
	"name": "ChatGPT",
	"behavior": "create",
	"noteContentFormat": "- [ ] TODO: modify the body to split the questions and answers, add tags and remove this line!!\n\n# Obsidian Notes\n\n- \n\n# AI Chat\n\n{{selectorHtml:div.\\@container\\/main > div | markdown}}\n\n",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{\\\"Make 4-5 lines description of the article. You are a professional in the field, and can explain things in detail\\\"}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "[[ChatGPT]]",
			"type": "multitext"
		},
		{
			"name": "tags",
			"value": "ai_chats",
			"type": "multitext"
		},
		{
			"name": "date_saved",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "dataSource",
			"value": "Obsidian Web Clipper",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "word_count",
			"value": "{{words}}",
			"type": "number"
		},
		{
			"name": "read_length_minutes",
			"value": "{{words|calc:\\\"/238\\\"}}",
			"type": "number"
		},
		{
			"name": "type",
			"value": "ai_chat",
			"type": "text"
		},
		{
			"name": "ai_model",
			"value": "ChatGPT",
			"type": "text"
		}
	],
	"triggers": [
		"https://chatgpt.com/"
	],
	"noteNameFormat": "AI Chat - ChatGPT - {{title}}",
	"path": "ai_chats/",
	"context": "{{content}}"
}