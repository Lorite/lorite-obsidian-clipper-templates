{
	"schemaVersion": "0.1.0",
	"name": "Instagram",
	"behavior": "create",
	"noteContentFormat": "\n# Obsidian Notes\n\n- \n\n# Original article\n\n{{title}}",
	"properties": [
		{
			"name": "title",
			"value": "",
			"type": "text"
		},
		{
			"name": "short_description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{\\\"Make 4-5 lines description of the article. You are a professional in the field, and can explain things in detail\\\"}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\",\\\"|join}}",
			"type": "multitext"
		},
		{
			"name": "image",
			"value": "{{image}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "media, websites",
			"type": "multitext"
		},
		{
			"name": "state",
			"value": "ARCHIVED",
			"type": "text"
		},
		{
			"name": "date_published",
			"value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "datetime"
		},
		{
			"name": "date_saved",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "dataSource",
			"value": "Obsidian Web Clipper",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "word_count",
			"value": "{{words}}",
			"type": "number"
		},
		{
			"name": "type",
			"value": "website",
			"type": "text"
		},
		{
			"name": "read_length_minutes",
			"value": "{{words|calc:\\\"/238\\\"}}",
			"type": "number"
		},
		{
			"name": "personal_rating",
			"value": "",
			"type": "number"
		}
	],
	"triggers": [
		"https://www.instagram.com/"
	],
	"noteNameFormat": "Instagram post - TODO - {{meta:name:twitter:title}}",
	"path": "media/websites",
	"context": "{{title}}"
}