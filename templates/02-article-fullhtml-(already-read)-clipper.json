{
	"schemaVersion": "0.1.0",
	"name": "Article fullHtml (ALREADY READ)",
	"behavior": "create",
	"noteContentFormat": "- [ ] TODO: add tags and remove this line!!\n\n# Obsidian Notes\n\n- \n\n# Highlights\n\n- {{highlights|map: item => item.text|join:\\\"\\\\n- \\\"}}\n\n---\n\n# {{title}}\n\n{{fullHtml|markdown}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "short_description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{\\\"Make 4-5 lines description of the article. You are a professional in the field, and can explain things in detail\\\"}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\",\\\"|join}}",
			"type": "multitext"
		},
		{
			"name": "image",
			"value": "{{image}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "media, articles",
			"type": "multitext"
		},
		{
			"name": "state",
			"value": "ARCHIVED",
			"type": "text"
		},
		{
			"name": "date_published",
			"value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "datetime"
		},
		{
			"name": "date_saved",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "date_read",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm\\\"}}",
			"type": "datetime"
		},
		{
			"name": "dataSource",
			"value": "Obsidian Web Clipper",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "word_count",
			"value": "{{words}}",
			"type": "number"
		},
		{
			"name": "type",
			"value": "article",
			"type": "text"
		},
		{
			"name": "read_length_minutes",
			"value": "{{words|calc:\\\"/238\\\"}}",
			"type": "number"
		},
		{
			"name": "publish",
			"value": "true",
			"type": "checkbox"
		},
		{
			"name": "publish_mode",
			"value": "external",
			"type": "text"
		},
		{
			"name": "personal_rating",
			"value": "",
			"type": "number"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title}} - {{author|split:\\\", \\\"|join}}",
	"path": "media/articles",
	"context": "{{content}}"
}